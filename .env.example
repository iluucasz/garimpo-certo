# Recommended for most uses
DATABASE_URL=

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=

# Parameters for constructing your own connection string
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGDATABASE=
PGPASSWORD=

# Parameters for Vercel Postgres Templates
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
POSTGRES_URL_NO_SSL=
POSTGRES_PRISMA_URL=

BLOB_READ_WRITE_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# E-mail transacional (redefinição de senha) via Resend — https://resend.com
# Sem estas duas variáveis o envio fica desativado e o link de redefinição só é logado no servidor.
# EMAIL_FROM precisa ser um remetente de domínio verificado no Resend, ex.: "Garimpo certo <nao-responda@seudominio.com.br>"
RESEND_API_KEY=
EMAIL_FROM=

# Endereço público do site (domínio canônico). Sem ele, usa o domínio de produção da Vercel.
NEXT_PUBLIC_SITE_URL=

# Contato exibido na página de privacidade para pedidos da LGPD que o autoatendimento não cobre.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Importação agendada da Shopee (Vercel Cron envia este valor como Bearer). Sem ele a rota fica desligada.
CRON_SECRET=

# Banco usado por `pnpm test` quando definido (ex.: um branch do Neon só para testes). Sem ele, os testes
# de integração usam DATABASE_URL e criam/removem os próprios registros no banco real.
TEST_DATABASE_URL=

# 1 = serve as imagens originais, sem o otimizador do Next.
NEXT_IMAGE_UNOPTIMIZED=

# 1 = mostra de volta os módulos de demonstração do painel admin (dados de exemplo, CRUD em localStorage).
NEXT_PUBLIC_ADMIN_DEMO_MODULES=

# Login com Google (opcional) — redirect URI a cadastrar no Google Cloud Console:
# {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Shopee Afiliados — Open API. Credenciais em affiliate.shopee.com.br > "Abrir API".
# Uso só no servidor; nunca expor com prefixo NEXT_PUBLIC_.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_APP_SECRET=
